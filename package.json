{
  "name": "3as-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:admin\"",
    "dev:client": "cd apps/client && bun run dev",
    "dev:admin": "cd apps/admin && bun run dev",
    "typecheck": "cd apps/client && bun run typecheck && cd ../admin && bun run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
